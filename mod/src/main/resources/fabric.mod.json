{
  "schemaVersion": 1,
  "id": "lyrica",
  "version": "${version}",
  "name": "Lyrica",
  "icon": "icon.png",
  "description": "A better way to experience music lyrics inside Minecraft.",
  "authors": ["Fakiz"],
  "contact": {
    "sources": "https://github.com/fakemaluco/lyrica-mod"
  },
  "license": "AGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.fandroid.FanDroidMod"],
    "client": ["dev.fandroid.client.FanDroidClient"],
    "voicechat": ["dev.fandroid.voice.FanDroidVoicePlugin"]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21",
    "fabric-api": "${fabric_api_dependency}"
  },
  "suggests": {
    "voicechat": "${voicechat_dependency}",
    "essential-container": ">=1.0.0",
    "modmenu": "*",
    "controlify": "*",
    "minecraft-cursor": "*",
    "cursors_extended": "*",
    "mousetweaks": "*",
    "emi": "*",
    "roughlyenoughitems": "*",
    "iris": "*",
    "sodium": "*",
    "immediatelyfast": "*",
    "xaerominimap": "*",
    "appleskin": "*"
  }
}
