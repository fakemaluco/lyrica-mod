{
  "schemaVersion": 1,
  "id": "lyrica",
  "version": "${version}",
  "name": "Lyrica",
  "icon": "icon.png",
  "description": "Synchronized music lyrics for Minecraft.",
  "authors": [
    "Lyrica contributors"
  ],
  "contact": {
    "sources": "https://github.com/fakemaluco/lyrica-mod"
  },
  "license": "AGPL-3.0-only",
  "environment": "*",
  "mixins": [{"config": "relaylyrics.client.mixins.json", "environment": "client"}],
  "entrypoints": {
    "main": ["dev.relaylyrics.karaoke.KaraokeNetwork"],
    "client": [
      "dev.relaylyrics.client.RelayLyricsClient"
    ],
    "modmenu": [
      "dev.relaylyrics.client.RelayLyricsModMenu"
    ],
    "lambdynlights:initializer": [
      {
        "adapter": "lyrica_optional_lighting",
        "value": "dev.relaylyrics.client.WorldLyricsLightIntegration"
      }
    ],
    "jade": [
      "dev.relaylyrics.client.compat.LyricaJadePlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21",
    "fabric-api": "${fabric_api_dependency}"
  },
  "suggests": {
    "modmenu": "*",
    "controlify": "*",
    "minecraft-cursor": "*",
    "cursors_extended": "*",
    "mousetweaks": "*",
    "emi": "*",
    "roughlyenoughitems": "*",
    "iris": "*",
    "sodium": "*",
    "immediatelyfast": "*",
    "xaerominimap": "*",
    "appleskin": "*",
    "lambdynlights": ">=4.8.0",
    "ji-afk-cinematic": "*",
    "jade": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "client"
      ]
    }
  },
  "languageAdapters": {
    "lyrica_optional_lighting": "dev.relaylyrics.client.WorldLyricsLightAdapter"
  }
}
